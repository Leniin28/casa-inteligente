# Copia este archivo como .env y ajusta lo que necesites. No contiene secretos.

# Base de datos SQLite local
SMARTHOME_DATABASE_URL=sqlite:///./smarthome.db

# Origen de datos: por ahora solo "demo" (simulado)
SMARTHOME_DATA_MODE=demo

# Zona horaria para calcular "hoy" (vacío = la del sistema). Ej: America/Mexico_City
SMARTHOME_TIMEZONE=

# Duración de las sesiones en horas
SMARTHOME_SESSION_TTL_HOURS=72

# Usuario de demostración creado al arrancar (documentado, no es un secreto)
SMARTHOME_SEED_DEMO_USER=true
SMARTHOME_DEMO_USER_EMAIL=demo@casa.local
SMARTHOME_DEMO_USER_PASSWORD=demo1234

# Precios para el coste estimado del historial
SMARTHOME_ELECTRICITY_PRICE_PER_KWH=0.15
SMARTHOME_WATER_PRICE_PER_LITER=0.002
